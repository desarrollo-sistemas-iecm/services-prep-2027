# Database Configuration SQLite
DB_CLIENT=sqlite3
DB_TYPE=sqlite
DB_DATABASE=./data/database.db3
DB_STORAGE=./data/database.db3
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=configurarSecretoDelPREP
JWT_EXPIRES_IN=1h

# Application Configuration
NODE_ENV=development
PORT=3009
API_PREFIX=api/v1

# Application Base URL for Email Links
APP_BASE_URL=https://prep.iecm.mx

# Encryption Configuration
BCRYPT_ROUNDS=10

# Swagger Configuration
SWAGGER_TITLE=CNNA API
SWAGGER_DESCRIPTION=API para la consulta de niñas, niños y adolescentes en el IECM
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

CORS_ORIGINS=https://prep.iecm.mx