# Database Configuration SQLite
DB_CLIENT=sqlite3
DB_TYPE=sqlite
DB_DATABASE=./data/database.db3
DB_STORAGE=./data/database.db3
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=configurarSecretoDelPREP
JWT_EXPIRES_IN=1h

# Application Configuration
NODE_ENV=development
PORT=3009
API_PREFIX=api/v1

# Application Base URL for Email Links
APP_BASE_URL=https://prep.iecm.mx

# Encryption Configuration
BCRYPT_ROUNDS=10

# Swagger Configuration
SWAGGER_TITLE=PREP API
SWAGGER_DESCRIPTION=API para PREP (Resultados Preliminares) del IECM
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

CORS_ORIGINS=https://prep.iecm.mx



CONTROL_DB_STORAGE=./data/control.db3
CORTES_MANIFEST_HMAC_SECRET=configurarSecretoDelCortes
CORTES_MAX_UPLOAD_MB=100
CORTES_UPLOAD_RATE_LIMIT=5

# Metadata de versión (opcional, inyectada como build args por el Dockerfile
# de deployment-prep-2027; expuesta sin secretos en GET /api/v1/version)
APP_VERSION=unknown
GIT_COMMIT_BACKEND=unknown
GIT_COMMIT_FRONTEND=unknown
BUILD_DATE=unknown
IMAGE_DIGEST=unknown